
BMA_Lib : BMA_Date .

function : is_leap_year(year = integer) return boolean .
    if (year mod 400) == 0 then
        return true .
    end_if .
    if (year mod 100) == 0 then
        return false .
    end_if .
    if (year mod 4) == 0 then
        return true .
    end_if .
    return false .
end_func .

function : days_in_month(month = integer, year = integer) return integer .
    if month == 1 then
        return 31 .
    end_if .
    if month == 2 then
        if is_leap_year(year) then
            return 29 .
        end_if .
        return 28 .
    end_if .
    if month == 3 then
        return 31 .
    end_if .
    if month == 4 then
        return 30 .
    end_if .
    if month == 5 then
        return 31 .
    end_if .
    if month == 6 then
        return 30 .
    end_if .
    if month == 7 then
        return 31 .
    end_if .
    if month == 8 then
        return 31 .
    end_if .
    if month == 9 then
        return 30 .
    end_if .
    if month == 10 then
        return 31 .
    end_if .
    if month == 11 then
        return 30 .
    end_if .
    if month == 12 then
        return 31 .
    end_if .
    return 0 .
end_func .

function : is_valid_date(day = integer, month = integer, year = integer) return boolean .
    if year < 1 then
        return false .
    end_if .
    if month < 1 then
        return false .
    end_if .
    if month > 12 then
        return false .
    end_if .
    if day < 1 then
        return false .
    end_if .
    if day > days_in_month(month, year) then
        return false .
    end_if .
    return true .
end_func .

function : is_valid_time(hour = integer, minute = integer, second = integer) return boolean .
    if hour < 0 then
        return false .
    end_if .
    if hour > 23 then
        return false .
    end_if .
    if minute < 0 then
        return false .
    end_if .
    if minute > 59 then
        return false .
    end_if .
    if second < 0 then
        return false .
    end_if .
    if second > 59 then
        return false .
    end_if .
    return true .
end_func .

function : is_valid_datetime(day = integer, month = integer, year = integer, hour = integer, minute = integer, second = integer) return boolean .
    if not is_valid_date(day, month, year) then
        return false .
    end_if .
    if not is_valid_time(hour, minute, second) then
        return false .
    end_if .
    return true .
end_func .

function : is_january(month = integer) return boolean .
    return month == 1 .
end_func .

function : is_february(month = integer) return boolean .
    return month == 2 .
end_func .

function : is_march(month = integer) return boolean .
    return month == 3 .
end_func .

function : is_april(month = integer) return boolean .
    return month == 4 .
end_func .

function : is_may(month = integer) return boolean .
    return month == 5 .
end_func .

function : is_june(month = integer) return boolean .
    return month == 6 .
end_func .

function : is_july(month = integer) return boolean .
    return month == 7 .
end_func .

function : is_august(month = integer) return boolean .
    return month == 8 .
end_func .

function : is_september(month = integer) return boolean .
    return month == 9 .
end_func .

function : is_october(month = integer) return boolean .
    return month == 10 .
end_func .

function : is_november(month = integer) return boolean .
    return month == 11 .
