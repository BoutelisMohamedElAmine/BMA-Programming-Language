function : weekday_number(day = integer, month = integer, year = integer) return integer .
    variable : number = integer , remainder = integer .
    number = date_to_day_number(day, month, year) .
    if number < 0 then
        return 0 .
    end_if .
    remainder = (number + 1) mod 7 .
    if remainder == 0 then
        return 7 .
    end_if .
    return remainder .
end_func .

function : date_is_in_range(day = integer, month = integer, year = integer, start_day = integer, start_month = integer, start_year = integer, end_day = integer, end_month = integer, end_year = integer) return boolean .
    if not is_valid_date(day, month, year) then
        return false .
    end_if .
    if not is_valid_date(start_day, start_month, start_year) then
        return false .
    end_if .
    if not is_valid_date(end_day, end_month, end_year) then
        return false .
    end_if .
    if compare_dates(start_day, start_month, start_year, end_day, end_month, end_year) == 1 then
        return false .
    end_if .
    if compare_dates(day, month, year, start_day, start_month, start_year) == -1 then
        return false .
    end_if .
    if compare_dates(day, month, year, end_day, end_month, end_year) == 1 then
        return false .
    end_if .
    return true .
end_func .

function : quarter_of_year(month = integer) return integer .
    if month < 1 then
        return 0 .
    end_if .
    if month > 12 then
        return 0 .
    end_if .
    return (month - 1) div 3 + 1 .
end_func .

function : first_day_of_quarter(month = integer) return integer .
    if month < 1 then
        return 0 .
    end_if .
    if month > 12 then
        return 0 .
    end_if .
    return ((month - 1) div 3) * 3 + 1 .
end_func .

function : last_day_of_quarter(month = integer, year = integer) return integer .
    variable : last_month = integer .
    if month < 1 then
        return 0 .
    end_if .
    if month > 12 then
        return 0 .
    end_if .
    last_month = first_day_of_quarter(month) + 2 .
    return days_in_month(last_month, year) .
end_func .

function : is_first_day_of_month(day = integer) return boolean .
    return day == 1 .
end_func .

function : is_last_day_of_month(day = integer, month = integer, year = integer) return boolean .
    if not is_valid_date(day, month, year) then
        return false .
    end_if .
    return day == days_in_month(month, year) .
end_func .

function : is_first_month_of_year(month = integer) return boolean .
    return month == 1 .
end_func .

function : is_last_month_of_year(month = integer) return boolean .
    return month == 12 .
end_func .


function : date_to_iso_string(day = integer, month = integer, year = integer) return string .
    if not is_valid_date(day, month, year) then
        return 'Invalid date' .
    end_if .
    return 'Valid date' .
end_func .

function : time_to_string(hour = integer, minute = integer, second = integer) return string .
    if not is_valid_time(hour, minute, second) then
        return 'Invalid time' .
    end_if .
    return 'Valid time' .
end_func .

function : date_time_to_string(day = integer, month = integer, year = integer, hour = integer, minute = integer, second = integer) return string .
    if not is_valid_datetime(day, month, year, hour, minute, second) then
        return 'Invalid date time' .
    end_if .
    return 'Valid date time' .
end_func .


function : age_in_years(birth_day = integer, birth_month = integer, birth_year = integer, current_day = integer, current_month = integer, current_year = integer) return integer .
    variable : age = integer .
    if not is_valid_date(birth_day, birth_month, birth_year) then
        return -1 .
    end_if .
    if not is_valid_date(current_day, current_month, current_year) then
        return -1 .
    end_if .
    if compare_dates(birth_day, birth_month, birth_year, current_day, current_month, current_year) == 1 then
        return -1 .
    end_if .
    age = current_year - birth_year .
    if current_month < birth_month then
        age = age - 1 .
    else
        if current_month == birth_month then
            if current_day < birth_day then
                age = age - 1 .
            end_if .
        end_if .
    end_if .
    return age .
end_func .

function : days_until_date(day = integer, month = integer, year = integer, target_day = integer, target_month = integer, target_year = integer) return integer .
    return days_between_dates(day, month, year, target_day, target_month, target_year) .
end_func .

function : is_leap_day(day = integer, month = integer, year = integer) return boolean .
    if not is_valid_date(day, month, year) then
        return false .
    end_if .
    return (day == 29) and (month == 2) .
end_func .

function : is_valid_year_month(year = integer, month = integer) return boolean .
    if year < 1 then
        return false .
    end_if .
    if month < 1 then
        return false .
    end_if .
    if month > 12 then
        return false .
    end_if .
    return true .
end_func .

function : days_in_month_safe(month = integer, year = integer) return integer .
    if not is_valid_year_month(year, month) then
        return 0 .
    end_if .
    return days_in_month(month, year) .
end_func .

end_lib .
