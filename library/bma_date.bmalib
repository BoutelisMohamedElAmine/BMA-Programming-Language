function : is_weekend_day(day_of_week = integer) return boolean .
    if day_of_week == 6 then
        return true .
    end_if .
    if day_of_week == 7 then
        return true .
    end_if .
    return false .
end_func .

function : is_weekday(day_of_week = integer) return boolean .
    if day_of_week < 1 then
        return false .
    end_if .
    if day_of_week > 7 then
        return false .
    end_if .
    if is_weekend_day(day_of_week) then
        return false .
    end_if .
    return true .
end_func .

function : compare_dates(day1 = integer, month1 = integer, year1 = integer, day2 = integer, month2 = integer, year2 = integer) return integer .
    if year1 < year2 then
        return -1 .
    end_if .
    if year1 > year2 then
        return 1 .
    end_if .
    if month1 < month2 then
        return -1 .
    end_if .
    if month1 > month2 then
        return 1 .
    end_if .
    if day1 < day2 then
        return -1 .
    end_if .
    if day1 > day2 then
        return 1 .
    end_if .
    return 0 .
end_func .

function : compare_times(hour1 = integer, minute1 = integer, second1 = integer, hour2 = integer, minute2 = integer, second2 = integer) return integer .
    if hour1 < hour2 then
        return -1 .
    end_if .
    if hour1 > hour2 then
        return 1 .
    end_if .
    if minute1 < minute2 then
        return -1 .
    end_if .
    if minute1 > minute2 then
        return 1 .
    end_if .
    if second1 < second2 then
        return -1 .
    end_if .
    if second1 > second2 then
        return 1 .
    end_if .
    return 0 .
end_func .

function : days_in_year(year = integer) return integer .
    if is_leap_year(year) then
        return 366 .
    end_if .
    return 365 .
end_func .

function : day_of_year(day = integer, month = integer, year = integer) return integer .
    variable : total = integer , current_month = integer .
    if not is_valid_date(day, month, year) then
        return 0 .
    end_if .
    total = day .
    current_month = 1 .
    while current_month < month do
        total = total + days_in_month(current_month, year) .
        current_month = current_month + 1 .
    end_while .
    return total .
end_func .

function : days_before_year(year = integer) return integer .
    variable : previous_year = integer .
    if year < 1 then
        return 0 .
    end_if .
    previous_year = year - 1 .
    return previous_year * 365 + previous_year div 4 - previous_year div 100 + previous_year div 400 .
end_func .

function : date_to_day_number(day = integer, month = integer, year = integer) return integer .
    if not is_valid_date(day, month, year) then
        return -1 .
    end_if .
    return days_before_year(year) + day_of_year(day, month, year) - 1 .
end_func .

function : days_between_dates(day1 = integer, month1 = integer, year1 = integer, day2 = integer, month2 = integer, year2 = integer) return integer .
    variable : first_number = integer , second_number = integer .
    first_number = date_to_day_number(day1, month1, year1) .
    second_number = date_to_day_number(day2, month2, year2) .
    if first_number < 0 then
        return -1 .
    end_if .
    if second_number < 0 then
        return -1 .
    end_if .
    return second_number - first_number .
end_func .

function : absolute_days_between(day1 = integer, month1 = integer, year1 = integer, day2 = integer, month2 = integer, year2 = integer) return integer .
    variable : difference = integer .
    difference = days_between_dates(day1, month1, year1, day2, month2, year2) .
    if difference < 0 then
        if difference == -1 then
            return -1 .
        end_if .
        return 0 - difference .
    end_if .
    return difference .
end_func .

function : add_days(day = integer, month = integer, year = integer, amount = integer) return integer .
    variable : current_day = integer , current_month = integer , current_year = integer , remaining = integer .
    if not is_valid_date(day, month, year) then
        return -1 .
    end_if .
    current_day = day .
    current_month = month .
    current_year = year .
    remaining = amount .
    while remaining > 0 do
        current_day = current_day + 1 .
        if current_day > days_in_month(current_month, current_year) then
            current_day = 1 .
            current_month = current_month + 1 .
            if current_month > 12 then
                current_month = 1 .
                current_year = current_year + 1 .
            end_if .
        end_if .
        remaining = remaining - 1 .
    end_while .
    while remaining < 0 do
        current_day = current_day - 1 .
        if current_day < 1 then
            current_month = current_month - 1 .
            if current_month < 1 then
                current_month = 12 .
                current_year = current_year - 1 .
            end_if .
            if current_year < 1 then
                return -1 .
            end_if .
            current_day = days_in_month(current_month, current_year) .
        end_if .
        remaining = remaining + 1 .
    end_while .
    return date_to_day_number(current_day, current_month, current_year) .
end_func .

function : add_months_day(day = integer, month = integer, year = integer, amount = integer) return integer .
    variable : total_month = integer , target_month = integer , target_year = integer , target_day = integer .
    if not is_valid_date(day, month, year) then
        return -1 .
    end_if .
    total_month = (year - 1) * 12 + month - 1 + amount .
    if total_month < 0 then
        return -1 .
    end_if .
    target_year = total_month div 12 + 1 .
    target_month = total_month mod 12 + 1 .
    target_day = day .
    if target_day > days_in_month(target_month, target_year) then
        target_day = days_in_month(target_month, target_year) .
    end_if .
    return date_to_day_number(target_day, target_month, target_year) .
end_func .

function : seconds_since_midnight(hour = integer, minute = integer, second = integer) return integer .
    if not is_valid_time(hour, minute, second) then
        return -1 .
    end_if .
    return hour * 3600 + minute * 60 + second .
end_func .

function : time_difference_seconds(hour1 = integer, minute1 = integer, second1 = integer, hour2 = integer, minute2 = integer, second2 = integer) return integer .
    variable : first_seconds = integer , second_seconds = integer .
    first_seconds = seconds_since_midnight(hour1, minute1, second1) .
    second_seconds = seconds_since_midnight(hour2, minute2, second2) .
    if first_seconds < 0 then
        return -1 .
    end_if .
    if second_seconds < 0 then
        return -1 .
    end_if .
    return second_seconds - first_seconds .
end_func .

function : absolute_time_difference_seconds(hour1 = integer, minute1 = integer, second1 = integer, hour2 = integer, minute2 = integer, second2 = integer) return integer .
    variable : difference = integer .
    difference = time_difference_seconds(hour1, minute1, second1, hour2, minute2, second2) .
    if difference < 0 then
        return 0 - difference .
    end_if .
    return difference .
end_func .

function : seconds_to_hours(seconds = integer) return integer .
    if seconds < 0 then
        return -1 .
    end_if .
    return seconds div 3600 .
end_func .

function : seconds_to_minutes(seconds = integer) return integer .
    if seconds < 0 then
        return -1 .
    end_if .
    return seconds div 60 .
end_func .

function : minutes_to_hours(minutes = integer) return integer .
    if minutes < 0 then
        return -1 .
    end_if .
    return minutes div 60 .
end_func .

function : seconds_remainder_minute(seconds = integer) return integer .
    if seconds < 0 then
        return -1 .
    end_if .
    return seconds mod 60 .
end_func .

function : minutes_remainder_hour(minutes = integer) return integer .
    if minutes < 0 then
        return -1 .
    end_if .
    return minutes mod 60 .
end_func .

function : hour_from_seconds(seconds = integer) return integer .
    if seconds < 0 then
        return -1 .
    end_if .
    return (seconds div 3600) mod 24 .
end_func .

function : minute_from_seconds(seconds = integer) return integer .
    if seconds < 0 then
        return -1 .
    end_if .
    return (seconds div 60) mod 60 .
end_func .

function : second_from_seconds(seconds = integer) return integer .
    if seconds < 0 then
        return -1 .
    end_if .
    return seconds mod 60 .
end_func .

function : is_am(hour = integer) return boolean .
    if hour < 0 then
        return false .
    end_if .
    if hour > 23 then
        return false .
    end_if .
    return hour < 12 .
end_func .

function : is_pm(hour = integer) return boolean .
    if hour < 0 then
        return false .
    end_if .
    if hour > 23 then
        return false .
    end_if .
    return hour >= 12 .
end_func .

function : to_12_hour(hour = integer) return integer .
    if hour < 0 then
        return -1 .
    end_if .
    if hour > 23 then
        return -1 .
    end_if .
    if hour == 0 then
        return 12 .
    end_if .
    if hour > 12 then
        return hour - 12 .
    end_if .
    return hour .
end_func .

function : is_midnight(hour = integer, minute = integer, second = integer) return boolean .
    if not is_valid_time(hour, minute, second) then
        return false .
    end_if .
    return (hour == 0) and (minute == 0) and (second == 0) .
end_func .

function : is_noon(hour = integer, minute = integer, second = integer) return boolean .
    if not is_valid_time(hour, minute, second) then
        return false .
    end_if .
    return (hour == 12) and (minute == 0) and (second == 0) .
end_func .

function : is_same_date(day1 = integer, month1 = integer, year1 = integer, day2 = integer, month2 = integer, year2 = integer) return boolean .
    return (day1 == day2) and (month1 == month2) and (year1 == year2) .
end_func .

function : is_same_time(hour1 = integer, minute1 = integer, second1 = integer, hour2 = integer, minute2 = integer, second2 = integer) return boolean .
    return (hour1 == hour2) and (minute1 == minute2) and (second1 == second2) .
end_func .

function : is_date_before(day1 = integer, month1 = integer, year1 = integer, day2 = integer, month2 = integer, year2 = integer) return boolean .
    return compare_dates(day1, month1, year1, day2, month2, year2) == -1 .
end_func .

function : is_date_after(day1 = integer, month1 = integer, year1 = integer, day2 = integer, month2 = integer, year2 = integer) return boolean .
    return compare_dates(day1, month1, year1, day2, month2, year2) == 1 .
end_func .

function : is_time_before(hour1 = integer, minute1 = integer, second1 = integer, hour2 = integer, minute2 = integer, second2 = integer) return boolean .
    return compare_times(hour1, minute1, second1, hour2, minute2, second2) == -1 .
end_func .

function : is_time_after(hour1 = integer, minute1 = integer, second1 = integer, hour2 = integer, minute2 = integer, second2 = integer) return boolean .
    return compare_times(hour1, minute1, second1, hour2, minute2, second2) == 1 .
end_func .

