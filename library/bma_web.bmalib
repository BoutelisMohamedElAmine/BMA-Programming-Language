BMA_Lib : BMA_Web .

/*{ ═══════════════════════════════════════════════════════════════
  BMA_Web 2.0 — Legendary Edition
  Complete HTTP + JSON + Files + Strings + URL + HTML toolkit
  ~50 natives, ~70 BMA functions
  ═══════════════════════════════════════════════════════════════
  Note: If library fails with "no implementation exists",
  remove that single native line — everything else will work.
  ═══════════════════════════════════════════════════════════════ }
*/

//{ ─────────── HTTP Natives ─────────── }
native : http_get(url = string) return string .
native : http_post(url = string, body = string) return string .
native : http_put(url = string, body = string) return string .
native : http_delete(url = string) return string .
native : http_download(url = string, path = string) return boolean .

native : http_last_status() return integer .
native : http_last_error() return string .
native : http_add_header(name = string, value = string) return void .
native : http_clear_headers() return void .
native : http_set_timeout(ms = integer) return void .

//{ ─────────── URL Natives ─────────── }
native : url_encode(s = string) return string .
native : url_decode(s = string) return string .
native : resolve_url(base = string, rel = string) return string .

//{ ─────────── JSON Natives ─────────── }
native : json_valid(s = string) return boolean .
native : json_has(s = string, path = string) return boolean .
native : json_get(s = string, path = string) return string .
native : json_get_int(s = string, path = string) return integer .
native : json_get_real(s = string, path = string) return real .
native : json_get_bool(s = string, path = string) return boolean .

//{ ─────────── String Natives ─────────── }
native : lower(s = string) return string .
native : upper(s = string) return string .
native : trim(s = string) return string .
native : length(s = string) return integer .
native : contains(s = string, sub = string) return boolean .
native : starts_with(s = string, prefix = string) return boolean .
native : ends_with(s = string, suffix = string) return boolean .
native : index_of(s = string, sub = string) return integer .
native : substring(s = string, start = integer, count = integer) return string .
native : replace(s = string, old = string, new = string) return string .
native : reverse(s = string) return string .
native : char_at(s = string, index = integer) return string .
native : repeat_str(s = string, n = integer) return string .
native : extract_between(text = string, start = string, end_tag = string) return array_string .

//{ ─────────── File Natives ─────────── }
native : read_file(path = string) return string .
native : write_file(path = string, content = string) return void .
native : append_file(path = string, content = string) return void .
native : file_exists(path = string) return boolean .
native : delete_file(path = string) return void .
native : file_size(path = string) return integer .
native : read_binary(path = string) return string .
native : write_binary(path = string, base64 = string) return boolean .
native : append_binary(path = string, base64 = string) return boolean .

//{ ─────────── Folder Natives ─────────── }
native : force_dirs(path = string) return boolean .
native : make_dir(path = string) return boolean .
native : dir_exists(path = string) return boolean .

//{ ─────────── Text Utilities ─────────── }
native : newline() return string .
native : tab() return string .
native : split(s = string, sep = string) return array_string .
native : join(arr = array_string, sep = string) return string .

//{ ─────────── Time Natives ─────────── }
native : sleep(ms = integer) return void .
native : get_tick_count() return integer .


/* { ═══════════════════════════════════════════════════════════════
  INTERNAL HELPERS — used by many functions below
  ═══════════════════════════════════════════════════════════════ }
*/

function : last_index_of_char(u = string, ch = string) return integer .
variable : i = integer , last = integer .
last = 0 - 1 .
i = 0 .
while i < length(u) do
    if char_at(u, i) == ch then
        last = i .
    end_if .
    i = i + 1 .
end_while .
return last .
end_func .

