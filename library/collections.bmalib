BMA_Lib : collections .

native : find ( arr=array_integer , value=integer ) return integer .
native : contains_array ( arr=array_integer , value=integer ) return boolean .
native : min_array ( arr=array_integer ) return integer .
native : max_array ( arr=array_integer ) return integer .
native : sum_array ( arr=array_integer ) return integer .
native : reverse_array ( arr=array_integer ) return void .

function : sort ( arr=array_integer ) return void .
            variable : i=integer , j=integer , n=integer , temp=integer .
            n = length(arr) .
            if n <= 1 then
                        return .
            end_if .
            for i = 0 to n - 2 do
                        for j = 0 to n - 2 - i do
                                    if arr[j] > arr[j + 1] then
                                                temp = arr[j] .
                                                arr[j] = arr[j + 1] .
                                                arr[j + 1] = temp .
                                    end_if .
                        end_for .
            end_for .
            return .
end_func .

function : sort_desc ( arr=array_integer ) return void .
            variable : i=integer , j=integer , n=integer , temp=integer .
            n = length(arr) .
            if n <= 1 then
                        return .
            end_if .
            for i = 0 to n - 2 do
                        for j = 0 to n - 2 - i do
                                    if arr[j] < arr[j + 1] then
                                                temp = arr[j] .
                                                arr[j] = arr[j + 1] .
                                                arr[j + 1] = temp .
                                    end_if .
                        end_for .
            end_for .
            return .
end_func .

end_lib .