BMA_Lib : math .

/* ═══════════════════════════════════════════════════
  الأنواع الأساسية (native — لا بديل لها في BMA)
  ═══════════════════════════════════════════════════ */

//{ ثوابت رياضية }
native : pi() return real .
native : e() return real .

//{ الدوال المتسامية — تحتاج تنفيذاً أصلياً }
native : sqrt(x = real) return real .
native : sin(x = real) return real .
native : cos(x = real) return real .
native : tan(x = real) return real .
native : atan2(y = real, x = real) return real .
native : pow(x = real, y = real) return real .
native : log(x = real) return real .
native : log10(x = real) return real .
native : exp(x = real) return real .

//{ التحويلات والنوعية — تحتاج سلوكاً أصلياً }
native : floor(x = real) return integer .
native : round(x = real) return integer .
native : abs(x = real) return real .
native : min(a = real, b = real) return real .
native : max(a = real, b = real) return real .

//{ العشوائية الأساسية }
native : random() return real .
native : random_int(n = integer) return integer .


/* ═══════════════════════════════════════════════════
  1) دوال أساسية مبنية بـ BMA
  ═══════════════════════════════════════════════════ */

function : ceil(x = real) return integer .
variable : neg = real .
neg = 0.0 - x .
return 0 - floor(neg) .
end_func .

function : sign(x = real) return integer .
if x > 0.0 then
    return 1 .
end_if .
if x < 0.0 then
    return 0 - 1 .
end_if .
return 0 .
end_func .

function : sign_int(x = integer) return integer .
if x > 0 then
    return 1 .
end_if .
if x < 0 then
    return 0 - 1 .
end_if .
return 0 .
end_func .

function : abs_int(x = integer) return integer .
if x < 0 then
    return 0 - x .
end_if .
return x .
end_func .

function : square(x = real) return real .
return x * x .
end_func .

function : cube(x = real) return real .
return x * x * x .
end_func .

function : recip(x = real) return real .
variable : zero = real .
zero = 0.0 .
if x == zero then
    return zero .
end_if .
return 1.0 / x .
end_func .

function : hypot(a = real, b = real) return real .
variable : s = real .
s = (a * a) + (b * b) .
return sqrt(s) .
end_func .

function : average(a = real, b = real) return real .
variable : two = real .
two = 2.0 .
return (a + b) / two .
end_func .

function : average3(a = real, b = real, c = real) return real .
variable : three = real , s = real .
three = 3.0 .
s = a + b + c .
return s / three .
end_func .

function : clamp(x = real, lo = real, hi = real) return real .
if x < lo then
    return lo .
end_if .
if x > hi then
    return hi .
end_if .
return x .
end_func .

function : lerp(a = real, b = real, t = real) return real .
variable : d = real .
d = b - a .
return a + (d * t) .
end_func .

function : almost_equal(a = real, b = real, eps = real) return boolean .
variable : diff = real .
diff = a - b .
if diff < 0.0 then
    diff = 0.0 - diff .
end_if .
if diff < eps then
    return true .
end_if .
return false .
end_func .

function : min3(a = real, b = real, c = real) return real .
variable : m = real .
m = min(a, b) .
m = min(m, c) .
return m .
end_func .

function : max3(a = real, b = real, c = real) return real .
variable : m = real .
m = max(a, b) .
m = max(m, c) .
return m .
end_func .


/* ═══════════════════════════════════════════════════
  2) الزوايا
  ═══════════════════════════════════════════════════ */

function : deg2rad(deg = real) return real .
variable : p = real , f = real .
p = pi() .
f = p / 180.0 .
return deg * f .
end_func .

function : rad2deg(rad = real) return real .
variable : p = real , f = real .
p = pi() .
f = 180.0 / p .
return rad * f .
end_func .

function : sin_deg(deg = real) return real .
variable : r = real .
r = deg2rad(deg) .
return sin(r) .
end_func .

function : cos_deg(deg = real) return real .
variable : r = real .
r = deg2rad(deg) .
return cos(r) .
end_func .

function : tan_deg(deg = real) return real .
variable : r = real .
r = deg2rad(deg) .
return tan(r) .
end_func .


/*═══════════════════════════════════════════════════
  3) اللوغاريتمات المخصصة
  ═══════════════════════════════════════════════════ */

function : log2(x = real) return real .
variable : ln2 = real .
ln2 = log(2.0) .
return log(x) / ln2 .
end_func .

function : log_base(x = real, base = real) return real .
variable : lnb = real .
lnb = log(base) .
return log(x) / lnb .
end_func .


/* ═══════════════════════════════════════════════════
  4) فحص الأعداد
  ═══════════════════════════════════════════════════ */

function : is_even(n = integer) return boolean .
variable : two = integer , m = integer .
two = 2 .
m = n mod two .
if m == 0 then
    return true .
end_if .
return false .
end_func .

function : is_odd(n = integer) return boolean .
variable : b = boolean .
b = is_even(n) .
if b then
    return false .
end_if .
return true .
end_func .

function : is_prime(n = integer) return boolean .
variable : i = integer , limit = integer .
if n < 2 then
    return false .
end_if .
if n == 2 then
    return true .
end_if .
if (n mod 2) == 0 then
    return false .
end_if .
limit = floor(sqrt(n)) .
i = 3 .
while i <= limit do
    if (n mod i) == 0 then
        return false .
    end_if .
    i = i + 2 .
end_while .
return true .
end_func .


/*═══════════════════════════════════════════════════
  5) العمليات على الأعداد الصحيحة
  ═══════════════════════════════════════════════════ */

function : gcd(a = integer, b = integer) return integer .
variable : aa = integer , bb = integer , t = integer .
aa = a .
bb = b .
if aa < 0 then
    aa = 0 - aa .
end_if .
if bb < 0 then
    bb = 0 - bb .
end_if .
while bb <> 0 do
    t = aa mod bb .
    aa = bb .
    bb = t .
end_while .
return aa .
end_func .

function : lcm(a = integer, b = integer) return integer .
variable : g = integer , p = integer .
g = gcd(a, b) .
if g == 0 then
    return 0 .
end_if .
p = (a div g) * b .
return p .
end_func .

function : factorial(n = integer) return integer .
variable : r = integer , i = integer .
if n < 0 then
    return 0 .
end_if .
r = 1 .
i = 2 .
while i <= n do
    r = r * i .
    i = i + 1 .
end_while .
return r .
end_func .

function : fibonacci(n = integer) return integer .
variable : a = integer , b = integer , t = integer , i = integer .
if n < 0 then
    return 0 .
end_if .
a = 0 .
b = 1 .
i = 0 .
while i < n do
    t = a + b .
    a = b .
    b = t .
    i = i + 1 .
end_while .
return a .
end_func .

function : pow_int(base = integer, exp = integer) return integer .
variable : r = integer , i = integer .
if exp < 0 then
    return 0 .
end_if .
r = 1 .
i = 0 .
while i < exp do
    r = r * base .
    i = i + 1 .
end_while .
return r .
end_func .

function : sum_to(n = integer) return integer .
variable : a = integer .
if n <= 0 then
    return 0 .
end_if .
a = n + 1 .
return (n * a) div 2 .
end_func .

function : sum_range(a = integer, b = integer) return integer .
variable : total = integer , i = integer .
if a > b then
    return 0 .
end_if .
total = 0 .
i = a .
while i <= b do
    total = total + i .
    i = i + 1 .
end_while .
return total .
end_func .

function : digit_count(n = integer) return integer .
variable : m = integer , count = integer , ten = integer .
ten = 10 .
m = n .
if m < 0 then
    m = 0 - m .
end_if .
if m == 0 then
    return 1 .
end_if .
count = 0 .
while m > 0 do
    m = m div ten .
    count = count + 1 .
end_while .
return count .
end_func .

function : reverse_int(n = integer) return integer .
variable : m = integer , rev = integer , ten = integer , sg = integer .
m = n .
sg = 1 .
if m < 0 then
    sg = 0 - 1 .
    m = 0 - m .
end_if .
rev = 0 .
ten = 10 .
while m > 0 do
    rev = (rev * ten) + (m mod ten) .
    m = m div ten .
end_while .
return rev * sg .
end_func .

function : digit_sum(n = integer) return integer .
variable : m = integer , total = integer , ten = integer .
m = n .
if m < 0 then
    m = 0 - m .
end_if .
total = 0 .
ten = 10 .
while m > 0 do
    total = total + (m mod ten) .
    m = m div ten .
end_while .
return total .
end_func .

function : ceil_div(a = integer, b = integer) return integer .
variable : q = integer , r = integer .
if b == 0 then
    return 0 .
end_if .
q = a div b .
r = a mod b .
if r <> 0 then
    if (a > 0) == (b > 0) then
        q = q + 1 .
    end_if .
end_if .
return q .
end_func .


/* ═══════════════════════════════════════════════════
  6) العشوائية الموسّعة (بدون native إضافي)
  ═══════════════════════════════════════════════════ */


function : random_int(n = integer) return integer .
variable : r = real , nn = real .
if n <= 0 then
    return 0 .
end_if .
nn = n .
r = random() .
r = r * nn .
return floor(r) .
end_func .

function : random_int_max(max = integer) return integer .
variable : r = real , mm = real .
if max <= 0 then
    return 0 .
end_if .
mm = max .
r = random() .
r = r * mm .
return floor(r) .
end_func .

function : random_range(min = integer, max = integer) return integer .
variable : r = real , span = integer , span_r = real .
if min > max then
    return min .
end_if .
span = (max - min) + 1 .
span_r = span .
r = random() .
r = r * span_r .
return min + floor(r) .
end_func .

function : random_bool() return boolean .
variable : r = real , half = real .
half = 0.5 .
r = random() .
if r < half then
    return true .
end_if .
return false .
end_func .

function : random_sign() return integer .
variable : b = boolean .
b = random_bool() .
if b then
    return 1 .
end_if .
return 0 - 1 .
end_func .

function : random_float(min = real, max = real) return real .
variable : r = real , span = real .
span = max - min .
r = random() .
r = r * span .
return min + r .
end_func .

function : random_percent() return real .
variable : r = real , hundred = real .
hundred = 100.0 .
r = random() .
return r * hundred .
end_func .
/* ═══════════════════════════════════════════════════
  7) النسب المئوية
  ═══════════════════════════════════════════════════ */

function : percent(part = real, whole = real) return real .
variable : zero = real , hundred = real .
zero = 0.0 .
if whole == zero then
    return zero .
end_if .
hundred = 100.0 .
return (part / whole) * hundred .
end_func .

function : percent_of(p = real, whole = real) return real .
variable : hundred = real .
hundred = 100.0 .
return (p / hundred) * whole .
end_func .


/* ═══════════════════════════════════════════════════
  8) المسافات الهندسية
  ═══════════════════════════════════════════════════ */

function : distance_2d(x1 = real, y1 = real, x2 = real, y2 = real) return real .
variable : dx = real , dy = real .
dx = x2 - x1 .
dy = y2 - y1 .
return hypot(dx, dy) .
end_func .

function : manhattan_2d(x1 = real, y1 = real, x2 = real, y2 = real) return real .
variable : dx = real , dy = real .
dx = x2 - x1 .
dy = y2 - y1 .
if dx < 0.0 then
    dx = 0.0 - dx .
end_if .
if dy < 0.0 then
    dy = 0.0 - dy .
end_if .
return dx + dy .
end_func .

end_lib .