BMA_Lib : strings .

native : upper ( s=string ) return string .
native : lower ( s=string ) return string .
native : trim ( s=string ) return string .
native : length ( s=string ) return integer .
native : contains ( s=string , sub=string ) return boolean .
native : substring ( s=string , start=integer , len=integer ) return string .
native : index_of ( s=string , sub=string ) return integer .
native : starts_with ( s=string , prefix=string ) return boolean .
native : ends_with ( s=string , suffix=string ) return boolean .
native : replace ( s=string , old=string , new=string ) return string .
native : char_at ( s=string , index=integer ) return string .
native : repeat_str ( s=string , count=integer ) return string .
native : reverse ( s=string ) return string .
native : newline () return string .
native : tab () return string .
native : split ( s=string , sep=string ) return string .
native : join ( arr=string , sep=string ) return string .

function : is_empty ( s=string ) return boolean .
            return length(s) == 0 .
end_func .

function : equals_ignore_case ( a=string , b=string ) return boolean .
            return lower(a) == lower(b) .
end_func .

function : count_char ( s=string , c=string ) return integer .
            variable : i=integer , n=integer , total=integer .
            n = length(s) .
            total = 0 .
            for i = 0 to n - 1 do
                        if char_at(s, i) == c then
                                    total = total + 1 .
                        end_if .
            end_for .
            return total .
end_func .

function : is_palindrome ( s=string ) return boolean .
            variable : i=integer , j=integer .
            j = length(s) - 1 .
            for i = 0 to j do
                        if i >= j then
                                    break .
                        end_if .
                        if char_at(s, i) <> char_at(s, j) then
                                    return false .
                        end_if .
                        j = j - 1 .
            end_for .
            return true .
end_func .

function : inttostr ( n=integer ) return string .
            variable : result=string , digit=integer , negative=boolean .
            result = '' .
            negative = false .
            if n < 0 then
                        negative = true .
                        n = -n .
            end_if .
            if n == 0 then
                        return '0' .
            end_if .
            while n > 0 do
                        digit = n mod 10 .
                        result = char_at('0123456789', digit) + result .
                        n = n div 10 .
            end_while .
            if negative then
                        result = '-' + result .
            end_if .
            return result .
end_func .

function : to_string ( n=integer ) return string .
            variable : result=string , digit=integer , negative=boolean .
            result = '' .
            negative = false .
            if n < 0 then
                        negative = true .
                        n = -n .
            end_if .
            if n == 0 then
                        return '0' .
            end_if .
            while n > 0 do
                        digit = n mod 10 .
                        result = char_at('0123456789', digit) + result .
                        n = n div 10 .
            end_while .
            if negative then
                        result = '-' + result .
            end_if .
            return result .
end_func .

function : to_int ( s=string ) return integer .
            variable : i=integer , n=integer , result=integer , negative=boolean , digit=integer .
            n = length(s) .
            result = 0 .
            negative = false .
            i = 0 .
            if n == 0 then
                        return 0 .
            end_if .
            if char_at(s, 0) == '-' then
                        negative = true .
                        i = 1 .
            end_if .
            while i < n do
                        digit = index_of('0123456789', char_at(s, i)) .
                        if digit < 0 then
                                    return 0 .
                        end_if .
                        result = result * 10 + digit .
                        i = i + 1 .
            end_while .
            if negative then
                        result = -result .
            end_if .
            return result .
end_func .

end_lib .